{
  // Static app from ./public + API worker for /api/* with a private R2 bucket.
  "name": "fornyein",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "fornyein-assets" }
  ]
}
