{
  // Static app from ./public + API worker for /api/* with a private R2 bucket.
  "name": "fornyein",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "fornyein-assets" }
  ],
  // Cloudflare Access JWT check. These are NOT secrets (team domain + policy audience id).
  // The check stays off until ACCESS_AUD is filled in.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "calm-scene-5980.cloudflareaccess.com",
    "ACCESS_AUD": ""
  }
}
