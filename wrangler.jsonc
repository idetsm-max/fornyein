{
  // Static app from ./public + API worker for /api/* with a private R2 bucket and Workers AI (auto caption).
  "name": "fornyein",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "fornyein-assets" }
  ],
  // Cloudflare Workers AI (Whisper) for Auto caption. Free allocation per day, then pay-as-you-go: check your plan.
  "ai": { "binding": "AI" },
  // NOT secrets: Access team domain + policy audience id. The Access check stays off until ACCESS_AUD is filled in.
  // ASR_URL is OPTIONAL: leave it empty to use Workers AI; set it to use your own Whisper server instead.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "calm-scene-5980.cloudflareaccess.com",
    "ACCESS_AUD": "",
    "ASR_URL": ""
  }
}
