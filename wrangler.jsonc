{
  // Stage 10: static app from ./public + API worker for /api/* (R2 binding is added once the bucket exists).
  "name": "fornyein",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  }
  // After creating the R2 bucket, add:
  // "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "<your-bucket>" }]
}
